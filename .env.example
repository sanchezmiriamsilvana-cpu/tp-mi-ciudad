# URL base de la API REST de Mi Ciudad. Expo solo expone variables EXPO_PUBLIC_.
# Debe incluir protocolo http/https y no debe terminar en una ruta de recurso.
# Para probar en el celular usá la IP de la PC en la misma red Wi-Fi:
EXPO_PUBLIC_BASE_URL=http://192.168.100.31:3000

# (Opcional) Ruta del catálogo de audioguías.
# Por defecto se usa /lugares?porPagina=500 (cada lugar trae su objeto `audioguia`).
# Sólo cambiala si el backend expone otra ruta, por ejemplo:
# EXPO_PUBLIC_AUDIOGUIAS_PATH=/audioguias
